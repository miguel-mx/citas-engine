# ── OpenAlex (required) ───────────────────────────────────────────────────────
# A real CCM contact email keeps requests in OpenAlex's polite pool.
MAILTO=itprojects0@gmail.com
OPENALEX_BASE=https://api.openalex.org

# ── Ollama (only needed for /report) ──────────────────────────────────────────
OLLAMA_BASE=http://localhost:11434
MODEL=gemma4:e4b

# ── Fetch limits ──────────────────────────────────────────────────────────────
MAX_WORKS=500
MAX_CITING_PER_WORK=1000
COUNT_TOLERANCE=0.10
PAGE_SIZE=200
MAX_WORKERS=5

# ── Optional sources (leave blank to disable) ─────────────────────────────────
SCOPUS_API_KEY=
WOS_API_KEY=
